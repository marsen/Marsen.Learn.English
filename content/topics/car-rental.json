{
  "id": "car-rental",
  "title": "租車",
  "section": 1,
  "speakers": [
    {
      "id": "A",
      "role": "租車公司櫃台人員"
    },
    {
      "id": "B",
      "role": "來租車的客人"
    }
  ],
  "form": {
    "title": "Car Rental Booking Form",
    "instruction": "Write NO MORE THAN TWO WORDS AND/OR A NUMBER for each answer.",
    "rows": [
      {
        "label": "Booking type",
        "printed": "Standard rental"
      },
      {
        "label": "Family name",
        "field_id": "family_name",
        "section": "Personal details"
      },
      {
        "label": "First name",
        "field_id": "first_name",
        "section": "Personal details"
      },
      {
        "label": "Date of birth",
        "field_id": "date_of_birth",
        "section": "Personal details"
      },
      {
        "label": "Address",
        "field_id": "house_number",
        "section": "Personal details",
        "also": [
          "street_name"
        ],
        "template": "Address: {} {street_name}"
      },
      {
        "label": "Town",
        "field_id": "town",
        "section": "Personal details"
      },
      {
        "label": "Phone",
        "field_id": "phone",
        "section": "Personal details"
      },
      {
        "label": "Driving licence number",
        "field_id": "licence_number",
        "section": "Personal details"
      },
      {
        "label": "Main destination",
        "field_id": "destination",
        "section": "Purpose of trip",
        "template": "Main destination is {}, about two hours' drive from here.",
        "says": [
          "two hours"
        ]
      },
      {
        "label": "Staying at",
        "field_id": "hotel_name",
        "section": "Purpose of trip",
        "template": "Staying at {}, close to the railway station.",
        "says": [
          "station"
        ]
      },
      {
        "label": "Company",
        "field_id": "company_name",
        "section": "Purpose of trip",
        "template": "Visiting the offices of {}."
      },
      {
        "label": "Meeting day",
        "field_id": "meeting_day",
        "section": "Purpose of trip",
        "template": "The meeting is on {}, in the morning.",
        "says": [
          "morning"
        ]
      },
      {
        "label": "Type of car",
        "field_id": "car_type",
        "section": "Car and dates",
        "template": "Would like a {}, with air conditioning.",
        "says": [
          "air conditioning"
        ]
      },
      {
        "label": "Pick-up day",
        "field_id": "pickup_day",
        "section": "Car and dates",
        "template": "Will collect the car on {}."
      },
      {
        "label": "Pick-up place",
        "field_id": "pickup_place",
        "section": "Car and dates",
        "template": "Pick-up is from the {}; the desk opens at 8 a.m.",
        "says": [
          "8 a.m."
        ]
      },
      {
        "label": "Number of days",
        "field_id": "rental_days",
        "section": "Car and dates",
        "template": "Hire for {} days."
      },
      {
        "label": "Insurance",
        "field_id": "insurance",
        "section": "Extras and costs",
        "template": "Insurance: {}."
      },
      {
        "label": "Extra equipment",
        "field_id": "extra_item",
        "section": "Extras and costs",
        "template": "Extra equipment: {}."
      },
      {
        "label": "Fuel option",
        "field_id": "fuel_policy",
        "section": "Extras and costs",
        "template": "Fuel: {}."
      },
      {
        "label": "Deposit (£)",
        "field_id": "deposit",
        "section": "Extras and costs",
        "template": "A deposit of £{} is taken, and it is refunded when the car comes back.",
        "says": [
          "refund"
        ]
      },
      {
        "label": "Payment method",
        "field_id": "payment_method",
        "section": "Extras and costs",
        "template": "Pays by {}."
      },
      {
        "label": "Heard about us from",
        "field_id": "heard_from",
        "section": "Extras and costs",
        "template": "Heard about the company through {}."
      }
    ],
    "section_styles": {
      "Personal details": "list",
      "Purpose of trip": "paragraph",
      "Car and dates": "paragraph",
      "Extras and costs": "paragraph"
    }
  },
  "variants": [
    {
      "id": "tourist",
      "setting": "客人是來這座城市旅遊的遊客"
    },
    {
      "id": "business",
      "setting": "客人是出差來開會的上班族"
    }
  ],
  "fields_pool": [
    {
      "field_id": "family_name",
      "type": "name_spelled",
      "allowed_traps": [
        "spelling",
        "none"
      ],
      "answer_policy": "exact_word",
      "max_words": 1
    },
    {
      "field_id": "first_name",
      "type": "name_spelled",
      "allowed_traps": [
        "spelling",
        "none"
      ],
      "answer_policy": "exact_word",
      "max_words": 1
    },
    {
      "field_id": "date_of_birth",
      "type": "date",
      "allowed_traps": [
        "self_correction",
        "none"
      ],
      "answer_policy": "date_equivalence",
      "max_words": 2
    },
    {
      "field_id": "house_number",
      "type": "number",
      "allowed_traps": [
        "similar_numbers",
        "self_correction",
        "none"
      ],
      "answer_policy": "digits_only",
      "max_words": 1,
      "group": "address"
    },
    {
      "field_id": "street_name",
      "type": "name_spelled",
      "allowed_traps": [
        "spelling",
        "none"
      ],
      "answer_policy": "exact_word",
