{
  "id": "gym-membership",
  "title": "健身房入會",
  "section": 1,
  "speakers": [
    {
      "id": "A",
      "role": "健身房櫃台接待"
    },
    {
      "id": "B",
      "role": "來入會的新會員"
    }
  ],
  "form": {
    "title": "Fitness Club Registration",
    "instruction": "Write NO MORE THAN TWO WORDS AND/OR A NUMBER for each answer.",
    "rows": [
      {
        "label": "Joining fee",
        "printed": "Waived this month",
        "says": [
          "joining fee"
        ]
      },
      {
        "label": "Family name",
        "field_id": "family_name",
        "section": "Personal details"
      },
      {
        "label": "First name",
        "field_id": "first_name",
        "section": "Personal details"
      },
      {
        "label": "Date of birth",
        "field_id": "date_of_birth",
        "section": "Personal details"
      },
      {
        "label": "Address",
        "field_id": "house_number",
        "section": "Personal details",
        "also": [
          "street_name"
        ],
        "template": "Address: {} {street_name}"
      },
      {
        "label": "Town",
        "field_id": "town",
        "section": "Personal details"
      },
      {
        "label": "Phone",
        "field_id": "phone",
        "section": "Personal details"
      },
      {
        "label": "Emergency contact (surname)",
        "field_id": "emergency_contact",
        "section": "Personal details"
      },
      {
        "label": "Student card number",
        "field_id": "student_card_number",
        "section": "Study or work",
        "template": "Student card number {}."
      },
      {
        "label": "Campus",
        "field_id": "campus",
        "section": "Study or work",
        "template": "Studies at the {} campus, a short walk from the club.",
        "says": [
          "walk"
        ]
      },
      {
        "label": "Employer",
        "field_id": "employer",
        "section": "Study or work",
        "template": "Works for {} in the city centre.",
        "says": [
          "city centre"
        ]
      },
      {
        "label": "Office floor",
        "field_id": "work_floor",
        "section": "Study or work",
        "template": "The office is on floor {}, and there is a lift in the building.",
        "says": [
          "lift"
        ]
      },
      {
        "label": "Membership plan",
        "field_id": "membership_plan",
        "section": "Gym information",
        "template": "Chose the {} plan, which includes use of the pool and sauna.",
        "says": [
          "pool",
          "sauna"
        ]
      },
      {
        "label": "Start day",
        "field_id": "start_day",
        "section": "Gym information",
        "template": "Will start on {}, with a free induction session.",
        "says": [
          "induction"
        ]
      },
      {
        "label": "Preferred time",
        "field_id": "preferred_time",
        "section": "Gym information",
        "template": "Preferred time to train: {}."
      },
      {
        "label": "Main goal",
        "field_id": "goal",
        "section": "Gym information",
        "template": "Main goal: {}."
      },
      {
        "label": "Class interested in",
        "field_id": "class_interest",
        "section": "Gym information",
        "template": "Also interested in the {} class, which runs twice a week.",
        "says": [
          "twice"
        ]
      },
      {
        "label": "Sport played before",
        "field_id": "sport_background",
        "section": "Gym information",
        "template": "Has played {} before."
      },
      {
        "label": "Locker number",
        "field_id": "locker_number",
        "section": "Fees and payment",
        "template": "Locker number {}; there is a £10 deposit for the key.",
        "says": [
          "10",
          "deposit"
        ]
      },
      {
        "label": "Payment method",
        "field_id": "payment_method",
        "section": "Fees and payment",
        "template": "Membership fees are paid monthly. Pays by {}.",
        "says": [
          "monthly"
        ]
      },
      {
        "label": "Visits per week",
        "field_id": "visit_frequency",
        "section": "Fees and payment",
        "template": "Plans to come {} a week."
      },
      {
        "label": "Heard about us from",
        "field_id": "heard_from",
        "section": "Fees and payment",
        "template": "Heard about the club through {}."
      }
    ],
    "section_styles": {
      "Personal details": "list",
      "Study or work": "paragraph",
      "Gym information": "paragraph",
      "Fees and payment": "paragraph"
    }
  },
  "variants": [
    {
      "id": "student",
      "setting": "入會的人是附近大學的學生"
    },
    {
      "id": "employee",
      "setting": "入會的人是附近公司的上班族"
    }
  ],
  "fields_pool": [
    {
      "field_id": "family_name",
      "type": "name_spelled",
      "allowed_traps": [
        "spelling",
        "none"
      ],
      "answer_policy": "exact_word",
      "max_words": 1
    },
    {
      "field_id": "first_name",
      "type": "name_spelled",
      "allowed_traps": [
        "spelling",
        "none"
      ],
      "answer_policy": "exact_word",
      "max_words": 1
    },
    {
      "field_id": "date_of_birth",
      "type": "date",
      "allowed_traps": [
        "self_correction",
        "none"
      ],
      "answer_policy": "date_equivalence",
      "max_words": 2
    },
    {
      "field_id": "house_number",
      "type": "number",
      "allowed_traps": [
        "similar_numbers",
        "self_correction",
        "none"
      ],
      "answer_policy": "digits_only",
      "max_words": 1,
      "group": "address"
    },
    {
      "field_id": "street_name",
      "type": "name_spelled",
      "allowed_traps": [
        "spelling",
        "none"
      ],
      "answer_policy": "exact_word",
      "max_words": 2,
      "group": "address"
    },
    {
