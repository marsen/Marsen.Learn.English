{
  "id": "library-card",
  "title": "圖書館辦證",
  "section": 1,
  "speakers": [
    {
      "id": "A",
      "role": "圖書館櫃台職員"
    },
    {
      "id": "B",
      "role": "來辦證的民眾"
    }
  ],
  "form": {
    "title": "Library Membership Application",
    "instruction": "Write NO MORE THAN TWO WORDS AND/OR A NUMBER for each answer.",
    "rows": [
      {
        "label": "Application type",
        "printed": "New membership"
      },
      {
        "label": "Family name",
        "field_id": "family_name",
        "section": "Personal details"
      },
      {
        "label": "First name",
        "field_id": "first_name",
        "section": "Personal details"
      },
      {
        "label": "Date of birth",
        "field_id": "date_of_birth",
        "section": "Personal details"
      },
      {
        "label": "House number",
        "field_id": "house_number",
        "section": "Personal details"
      },
      {
        "label": "Street",
        "field_id": "street_name",
        "section": "Personal details"
      },
      {
        "label": "Town",
        "field_id": "town",
        "section": "Personal details"
      },
      {
        "label": "Phone",
        "field_id": "phone",
        "section": "Personal details"
      },
      {
        "label": "Occupation",
        "field_id": "occupation",
        "section": "About the applicant"
      },
      {
        "label": "Student number",
        "field_id": "student_number",
        "section": "About the applicant"
      },
      {
        "label": "Field of study",
        "field_id": "course",
        "section": "About the applicant",
        "template": "Studying {}"
      },
      {
        "label": "Years in the area",
        "field_id": "years_resident",
        "section": "About the applicant",
        "template": "Has lived in the area for {} years"
      },
      {
        "label": "Previous city",
        "field_id": "previous_city",
        "section": "About the applicant",
        "template": "Moved here from {}"
      },
      {
        "label": "Card collection day",
        "field_id": "pickup_day",
        "section": "Membership",
        "template": "Will collect the card on {}"
      },
      {
        "label": "Preferred branch",
        "field_id": "branch",
        "section": "Membership"
      },
      {
        "label": "Reason for joining",
        "field_id": "reason",
        "section": "Membership"
      },
      {
        "label": "Membership type",
        "field_id": "membership_type",
        "section": "Membership"
      },
      {
        "label": "Favourite subject",
        "field_id": "interest",
        "section": "Interests and contact"
      },
      {
        "label": "Visits per month",
        "field_id": "visit_frequency",
        "section": "Interests and contact"
      },
      {
        "label": "Heard about us from",
        "field_id": "heard_from",
        "section": "Interests and contact",
        "template": "Heard about the library through {}"
      },
      {
        "label": "Contact by",
        "field_id": "notification",
        "section": "Interests and contact",
        "template": "Contact by {}"
      }
    ]
  },
  "variants": [
    {
      "id": "student",
      "setting": "辦證的人是剛入學的大學生"
    },
    {
      "id": "resident",
      "setting": "辦證的人是剛搬來的居民"
    }
  ],
  "fields_pool": [
    {
      "field_id": "family_name",
      "type": "name_spelled",
      "allowed_traps": [
        "spelling",
        "none"
      ],
      "answer_policy": "exact_word",
      "max_words": 1
    },
    {
      "field_id": "first_name",
      "type": "name_spelled",
      "allowed_traps": [
        "spelling",
        "none"
      ],
      "answer_policy": "exact_word",
      "max_words": 1
    },
    {
      "field_id": "date_of_birth",
      "type": "date",
      "allowed_traps": [
        "self_correction",
        "none"
      ],
      "answer_policy": "date_equivalence",
      "max_words": 2
    },
    {
      "field_id": "house_number",
      "type": "number",
      "allowed_traps": [
        "similar_numbers",
        "self_correction",
        "none"
      ],
      "answer_policy": "digits_only",
      "max_words": 1,
      "group": "address"
    },
    {
      "field_id": "street_name",
      "type": "name_spelled",
      "allowed_traps": [
        "spelling",
        "none"
      ],
      "answer_policy": "exact_word",
      "max_words": 2,
      "group": "address"
    },
    {
      "field_id": "town",
