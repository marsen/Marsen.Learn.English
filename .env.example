# 範本：複製成 .env.local 並填入實際值（.env.local 不進 Git）

# 站台對外網址
SITE_URL=http://localhost:3100

# 資料庫連線（Neon Postgres）。一定要設，沒有就啟動失敗。
# 本機請連開發用的資料庫（Neon 的 dev branch），不要連正式資料庫。
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# 登入 session（隨機字串：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"）
AUTH_SECRET=replace_with_random_secret
# session 有效期，如 7d / 12h
AUTH_TOKEN_TTL=7d

# 寄登入信（Resend）。未設定時不寄信，登入碼直接顯示在登入頁（只限非正式環境）。
# RESEND_API_KEY=re_xxx
# MAIL_FROM=Marsen Learn English <login@marsen.me>

# 本機開發：上傳的音檔存放位置（不進 Git）。沒設定 R2 時一定要有。
AUDIO_LOCAL_DIR=.data/audio

# 錄音改存 Cloudflare R2（四個要一起設定；有設定就優先用 R2，瀏覽器直接跟 R2 下載）。
# Cloudflare 後台 → R2 → 建 bucket；再到「Manage API tokens」建一組 Object Read & Write 的金鑰。
# R2_ACCOUNT_ID=你的 Cloudflare account id
# R2_ACCESS_KEY_ID=xxx
# R2_SECRET_ACCESS_KEY=xxx
# R2_BUCKET=learn-english-audio

# 錄音經 Cloudflare 各地節點送出（workers/audio-gate，要先設定上面的 R2）。兩個要一起設定。
# AUDIO_PASS_SECRET 要跟 Workers 的密鑰一樣：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUDIO_CDN_BASE=https://audio.marsen.me
# AUDIO_PASS_SECRET=replace_with_random_secret
